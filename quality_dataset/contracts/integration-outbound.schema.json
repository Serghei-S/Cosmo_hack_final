{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cosmo-quality/integration-outbound/1.0",
  "title": "Expected quality result for ERP emulator v1.0",
  "type": "object",
  "required": ["message_id", "message_type", "schema_version", "source_system", "correlation_key", "requires_ack", "payload"],
  "additionalProperties": false,
  "properties": {
    "message_id": {"type": "string"},
    "message_type": {"const": "quality_result"},
    "schema_version": {"const": "1.0"},
    "source_system": {"const": "QUALITY-MVP"},
    "correlation_key": {"type": "string"},
    "requires_ack": {"const": true},
    "payload": {
      "type": "object",
      "required": ["item_id", "work_order_id", "quality_status", "basis_event_ids"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string"},
        "work_order_id": {"type": "string"},
        "quality_status": {"enum": ["accepted", "quarantined", "released_after_rework"]},
        "basis_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
