{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/integration-exchange.schema.json",
  "title": "ОРБИТА.QC ERP and MES exchange",
  "oneOf": [
    {
      "$ref": "#/$defs/workOrderDelivery"
    },
    {
      "$ref": "#/$defs/qualityResult"
    },
    {
      "$ref": "#/$defs/qualityResultAck"
    },
    {
      "$ref": "#/$defs/mesBatch"
    },
    {
      "$ref": "#/$defs/mesReceipt"
    }
  ],
  "$defs": {
    "identifier": {
      "$ref": "production-event.schema.json#/$defs/identifier"
    },
    "workOrderDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "deliver_at",
        "message"
      ],
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/identifier"
        },
        "deliver_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "message": {
          "$ref": "#/$defs/workOrder"
        }
      }
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "source_system",
        "sent_at",
        "payload"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/identifier"
        },
        "message_type": {
          "const": "work_order"
        },
        "schema_version": {
          "const": "1.0"
        },
        "source_system": {
          "$ref": "#/$defs/identifier"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "work_order_id",
            "item_type_id",
            "assembly_revision",
            "item_ids",
            "quantity"
          ],
          "properties": {
            "work_order_id": {
              "$ref": "#/$defs/identifier"
            },
            "item_type_id": {
              "$ref": "#/$defs/identifier"
            },
            "assembly_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "item_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "item_details": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item_id",
                  "item_type_id",
                  "assembly_revision"
                ],
                "properties": {
                  "item_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "item_type_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assembly_revision": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "qualityResultRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "quality_status",
        "basis_event_ids"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/identifier"
        },
        "quality_status": {
          "enum": [
            "accepted",
            "quarantined",
            "released_after_rework",
            "rework_required",
            "scrapped"
          ]
        },
        "basis_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_order_id"
      ],
      "properties": {
        "work_order_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "qualityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "source_system",
        "correlation_key",
        "requires_ack",
        "payload"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/identifier"
        },
        "message_type": {
          "const": "quality_result"
        },
        "schema_version": {
          "const": "1.0"
        },
        "source_system": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_key": {
          "$ref": "#/$defs/identifier"
        },
        "requires_ack": {
          "const": true
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_id",
            "work_order_id",
            "quality_status",
            "basis_event_ids"
          ],
          "properties": {
            "item_id": {
              "$ref": "#/$defs/identifier"
            },
            "work_order_id": {
              "$ref": "#/$defs/identifier"
            },
            "quality_status": {
              "enum": [
                "accepted",
                "quarantined",
                "released_after_rework",
                "rework_required",
                "scrapped"
              ]
            },
            "basis_event_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "qualityResultAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "source_system",
        "correlation_key",
        "attempt",
        "status",
        "error_code"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/identifier"
        },
        "message_type": {
          "const": "quality_result_ack"
        },
        "schema_version": {
          "const": "1.0"
        },
        "source_system": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_key": {
          "$ref": "#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "status": {
          "enum": [
            "accepted",
            "temporary_unavailable",
            "rejected"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "mesGatewayEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "type",
        "occurredAt",
        "itemKey",
        "itemTypeKey",
        "lineKey",
        "stationKey",
        "shiftKey",
        "data"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "operation_started",
            "operation_finished",
            "operation_paused",
            "operator_action",
            "machine_state"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "itemKey": {
          "$ref": "#/$defs/identifier"
        },
        "itemTypeKey": {
          "$ref": "#/$defs/identifier"
        },
        "lineKey": {
          "$ref": "#/$defs/identifier"
        },
        "stationKey": {
          "$ref": "#/$defs/identifier"
        },
        "shiftKey": {
          "$ref": "#/$defs/identifier"
        },
        "runKey": {
          "$ref": "#/$defs/identifier"
        },
        "operationKey": {
          "$ref": "#/$defs/identifier"
        },
        "actorKey": {
          "$ref": "#/$defs/identifier"
        },
        "equipmentKey": {
          "$ref": "#/$defs/identifier"
        },
        "data": {
          "type": "object",
          "maxProperties": 64
        }
      }
    },
    "mesBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "events"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/identifier"
        },
        "events": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/mesGatewayEvent"
          }
        }
      }
    },
    "mesReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "status",
        "receiptId",
        "errorCode"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "accepted",
            "retry",
            "rejected"
          ]
        },
        "receiptId": {
          "$ref": "#/$defs/identifier"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    }
  }
}
